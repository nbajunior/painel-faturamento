rules_version = '2';

// Regras de segurança do Firestore.
// Cole este conteúdo em: Console do Firebase > Firestore Database > Regras > Publicar.
//
// Lógica: só leem e gravam dados as pessoas cujo e-mail está na lista abaixo
// E que já confirmaram o e-mail pelo link enviado no "Primeiro acesso".
// Qualquer outra pessoa, mesmo logada, não vê nada.
//
// PARA INCLUIR OU TIRAR ALGUÉM: edite a lista, mantenha os e-mails em
// minúsculas, entre aspas simples e separados por vírgula (sem vírgula depois
// do último), e clique em Publicar no Console. Vale na hora.

service cloud.firestore {
  match /databases/{database}/documents {

    function emailAutorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'nilson.borges@aguasdorio.com.br',
          'thalliane.maia@aguasdorio.com.br',
          'raniere.silva@aguasdorio.com.br'
        ];
    }

    match /ciclos/{referencia} {
      allow read, write: if emailAutorizado();
    }
    match /orcados/{referencia} {
      allow read, write: if emailAutorizado();
    }
  }
}
